{
  "name": "terpedex-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8799",
    "db:local": "wrangler d1 execute terpedex --local --file=schema.sql",
    "db:remote": "wrangler d1 execute terpedex --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
